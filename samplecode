#LightGBMを用いて含水率を予測するモデル作成を行う
#moderugakusy
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.model_selection import GroupKFold
from sklearn.metrics import root_mean_squared_error
import lightgbm as lgb

#波長抽出→各帯域で標準化→各帯域でpca→LightGBMの順番でモデル構築を行う
#波長選択
band_5000 = '5002.66957'
band_5500 = '5500.23655'

#波長抽出
df_train_5000 = df_train.loc[:, band_5500:band_5000]
df_train_1_5000 = df_train_1.loc[:, band_5500:band_5000]
df_train_2_5000 = df_train_2.loc[:, band_5500:band_5000]

#主成分分析の成分数の設定
n_5000 = 2
n_1_5000 = 0
n_2_5000 = 3

#GroupKFoldを用いたクロスバリデーション（CV）の設定
gkf = GroupKFold(n_splits=5, shuffle=True, random_state=42)

#CVでデータを分割する関数
def CV_split(df_train, train_index, valid_index):
  train, valid = df_train.iloc[train_index].copy(), df_train.iloc[valid_index].copy()
  return train, valid

#標準化を学習データのみで行い、評価データに適応する関数
def Scaler(train, valid):
  scaler = StandardScaler()
  scaled_train = scaler.fit_transform(train)
  scaled_valid = scaler.transform(valid)
  return scaled_train, scaled_valid

#SNVを実装する関数
def SNV(train, valid):
    train_std = train.std(axis=1).replace(0, 1)
    valid_std = valid.std(axis=1).replace(0, 1)
    snv_train = train.sub(train.mean(axis=1), axis=0).div(train_std, axis=0)
    snv_valid = valid.sub(valid.mean(axis=1), axis=0).div(valid_std, axis=0)
    return snv_train, snv_valid

#主成分分析を学習データのみで行い、評価データに適応する関数
def apply_PCA(train, valid, n):
  pca = PCA(n_components=n)
  pca_train = pca.fit_transform(train)
  pca_valid = pca.transform(valid)
  return pca_train, pca_valid

#RMSE値の格納用リスト
rmse_list = []

# パラメータの設定
params = {
    "objective": "regression",
    "metric": "rmse",
    "verbosity": -1,
    "boosting_type": "gbdt",
    "random_state": 42,
    "num_leaves": 15,
    "max_depth": 5,
    "min_data_in_leaf": 50,
    "feature_fraction": 0.8,
    "bagging_fraction": 0.8,
    "bagging_freq": 1,
    "lambda_l2": 1.0,
    "learning_rate": 0.05
}

#GroupKFoldに用いる要因設定
groups = df_train['species number']

#ここからCVで処理する
for k, (train_index, valid_index) in enumerate(gkf.split(df_train, groups=groups)):
  #trainとvalidに分解
  train_5000, valid_5000 = CV_split(df_train_5000, train_index, valid_index)
  train_1_5000, valid_1_5000 = CV_split(df_train_1_5000, train_index, valid_index)
  train_2_5000, valid_2_5000 = CV_split(df_train_2_5000, train_index, valid_index)

  #SNV
  snv_train_5000, snv_valid_5000 = SNV(train_5000, valid_5000)

  #pca処理
  pca_train_5000, pca_valid_5000 = apply_PCA(snv_train_5000, snv_valid_5000, n_5000)
  pca_train_1_5000, pca_valid_1_5000 = apply_PCA(train_1_5000, valid_1_5000, n_1_5000)
  pca_train_2_5000, pca_valid_2_5000 = apply_PCA(train_2_5000, valid_2_5000, n_2_5000)

  #ベースライン特徴量を作成する
  train_base = df_spec.iloc[train_index].mean(axis=1).to_numpy().reshape(-1, 1)
  valid_base = df_spec.iloc[valid_index].mean(axis=1).to_numpy().reshape(-1, 1)

  #作成した特徴量を横につなげる
  X_train = np.hstack((pca_train_5000, pca_train_1_5000, pca_train_2_5000, train_base))
  X_valid = np.hstack((pca_valid_5000, pca_valid_1_5000, pca_valid_2_5000, valid_base))

  #含水率もtrainとvalidに分割
  y_train = df_train['含水率'].iloc[train_index]
  y_valid = df_train['含水率'].iloc[valid_index]

  #LightGBMに入力するデータの設定
  train_data = lgb.Dataset(X_train, label=y_train)

  #モデル学習
  model = lgb.train(
      params,
      train_data
  )

  #モデル評価
  y_pred = model.predict(X_valid)
  rmse = root_mean_squared_error(y_valid, y_pred)
  print(f'{k}Fold:rmse = {rmse}')
  rmse_list.append(rmse)
print(f'平均rmse:{np.mean(rmse_list)}')
